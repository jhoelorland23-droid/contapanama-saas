# Secretos — nunca versionar
.env
*.env
!*.env.example
*key*.txt
*token*.json
*token*.txt
*secret*
*.pem

# Entornos y cache
.venv/
venv/
node_modules/
__pycache__/
*.pyc
.vercel/
dist/
build/
.next/

# Documentos y datos (pesados, se respaldan aparte)
*.pdf
*.xlsx
*.xlsm
*.docx
*.png
*.jpg
*.jpeg
*.mp4
*.log

# Datos reales de la app de revision local (nunca versionar)
.local-data/

# Corridas crudas de QA: pueden contener credenciales o tokens de prueba.
# Conservar solo evidencia revisada y sin secretos en saas/docs/evidence/.
/saas/outputs/

# Instaladores, paquetes duplicados y respaldos: no pertenecen al codigo fuente.
*.zip
*.exe
*.msi
*.7z
*.tar
*.gz
*.dump
*.backup
*.sqlite
*.sqlite3
*.db
*.csv
.env.*
!.env.example
!.env.sample
