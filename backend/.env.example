# ── ContaPanamá SaaS — Variables de Entorno ─────────────────────────────────
# Copia este archivo como .env y ajusta los valores

NODE_ENV=development
PORT=4000

# PostgreSQL — cambia usuario/password según tu instalación
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contapanama

# JWT — genera uno seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_64_bytes_aleatorios_seguros
JWT_EXPIRES_IN=7d

# CORS — URL del frontend
FRONTEND_URL=http://localhost:5173

# Bcrypt rounds (10 = recomendado, 12 = más seguro pero más lento)
BCRYPT_ROUNDS=10

# ── Stripe (suscripciones) ────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── WhatsApp Business API (Meta Cloud API) ────────────────────────────────
# Obtener en: developers.facebook.com → Tu App → WhatsApp → Configuración de API
# WHATSAPP_TOKEN=EAAxxxxx...         # Token de acceso permanente de Graph API
# WHATSAPP_PHONE_ID=1234567890       # Phone Number ID (no el número, el ID)
# WHATSAPP_VERIFY_TOKEN=orlando_cpa_verify_2024  # Token para verificar webhook
#
# Webhook URL: https://tu-api.com/api/whatsapp/webhook
# Eventos a suscribir: messages
# Número Orlando CPA: +507 6929-5152
